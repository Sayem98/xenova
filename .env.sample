DEPLOYER_PRIVATE_KEY=

# BSC RPC endpoints. Defaults in hardhat.config.ts are the public Binance
# dataseed nodes. Those are fine for deploying, but they are pruned full nodes —
# forking against them fails with "missing trie node". Fork testing needs a paid
# ARCHIVE endpoint here (Alchemy, QuickNode, dRPC paid tier).
BSC_MAINNET_RPC=
BSC_TESTNET_RPC=

# Fork testing against real PancakeSwap/WBNB/USDT. Opt-in.
#   FORK_BSC=true npx hardhat test
FORK_BSC=
# Pin a block so fork runs are cached and deterministic.
FORK_BLOCK=

# API key for contract verification on BscScan.
BSCSCAN_API_KEY=

# Set to true to print a gas report alongside the test run.
REPORT_GAS=
