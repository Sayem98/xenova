DEPLOYER_PRIVATE_KEY=

# BSC RPC endpoints used for DEPLOYING. Defaults in hardhat.config.ts are the
# public Binance dataseed nodes, which are fine for sending transactions.
BSC_MAINNET_RPC=
BSC_TESTNET_RPC=

# Fork testing against real PancakeSwap/WBNB/USDT:
#   yarn test:fork
# This needs ARCHIVE state, which the dataseed nodes above cannot serve — they
# are pruned to ~100 blocks and fail with "missing trie node". It therefore does
# NOT reuse BSC_MAINNET_RPC. The default is Blast's public BSC endpoint, free and
# keyless, verified to serve archive state 5,000,000 blocks back. Leave blank
# unless you want to use your own provider.
BSC_ARCHIVE_RPC=

# Set automatically by `yarn test:fork`; only set by hand to fork outside a test.
FORK_BSC=
# Pin a block so fork runs are cached and deterministic.
FORK_BLOCK=

# API key for contract verification on BscScan.
BSCSCAN_API_KEY=

# --- Deployment ---

# Who receives ownership and the full 210,000,000 supply. Blank means the real
# owner in scripts/addresses.ts. Set this to a throwaway address for a testnet
# rehearsal so the production key never has to live on this machine — deploying
# to mainnet with this set to anything else is refused.
OWNER_ADDRESS=

# USDT on BSC testnet. Defaults to 0x7ef95a0FEE0Dd31b22626fA2e10Ee6A223F8a684
# ("Tether USD", 18 decimals, has a live WBNB pool). Only set this if your test
# pool uses a different one. Mainnet USDT is hardcoded in scripts/addresses.ts.
TESTNET_USDT=

# Where the USDT tax is sent. Defaults to the owner address when left blank.
TAX_RECEIVER=

# Set after scripts/deploy.ts. Read by addLiquidity, deployOracle, mockOracle
# and status.
TOKEN_ADDRESS=

# Set after scripts/deployOracle.ts, read by scripts/keeper.ts. Also lets
# scripts/mockOracle.ts reuse an existing mock instead of deploying a new one.
ORACLE_ADDRESS=

# Liquidity seeded by scripts/addLiquidity.ts. Testnet defaults shown — kept
# small because faucets drip ~0.1 BNB. Both are REQUIRED on mainnet.
LP_TOKENS=1000000
LP_BNB=0.05

# The 24h drop scripts/mockOracle.ts reports, in basis points (0-10000).
# 0 -> 3% floor, 1000 -> 25%, 1500 -> 50%, 1700 -> 60% cap.
DROP_BPS=

# Set to true to print a gas report alongside the test run.
REPORT_GAS=
